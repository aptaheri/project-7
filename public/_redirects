# Rules are matched top to bottom, first match wins. The API routes must come
# before the SPA catch-all or it swallows them. These live here rather than in
# netlify.toml because _redirects is processed first.
/api/owntracks     /.netlify/functions/owntracks              200!
/api/track         /.netlify/functions/track-feed             200!
# Public on purpose: country only, no coordinates. See where.mts.
/api/where         /.netlify/functions/where                  200!
# One rule per action: a :placeholder does not get substituted into the
# destination's query string, so the function saw no action at all.
/api/auth/me       /.netlify/functions/auth?action=me         200!
/api/auth/google   /.netlify/functions/auth?action=google      200!
/api/auth/logout   /.netlify/functions/auth?action=logout      200!
/api/viewers       /.netlify/functions/viewers                200!
/api/unsubscribe   /.netlify/functions/unsubscribe            200!
/api/email-admin   /.netlify/functions/email-admin            200!
/api/email-pref    /.netlify/functions/email-pref             200!

